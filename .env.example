# Copy to .env (git-ignored) and fill in real values. Never commit real secrets.
# See CLAUDE.md and docs/architecture.md for how these are used.

# Required only if joblens.ai.enabled=true (backend/src/main/resources/application.yml).
# Talking points are generated via OpenRouter's OpenAI-compatible endpoint - get a key from
# openrouter.ai/keys.
OPENROUTER_API_KEY=

# Optional: overrides OpenRouter's base URL. Defaults to https://openrouter.ai/api/v1.
OPENROUTER_BASE_URL=

# Optional: model name to request. Defaults to liquid/lfm-2.5-2.6b:free - free-tier models
# share overload-prone capacity pools on OpenRouter (a 429 "temporarily rate-limited upstream"
# is expected occasionally, even on a working key), so re-check openrouter.ai/api/v1/models if
# this one stops resolving or stays rate-limited.
OPENROUTER_MODEL=liquid/lfm-2.5-2.6b:free

# Required only if joblens.jev.enabled=true.
# Get one from TypeSafe AI: https://console.typesafe.ai/keys
JEV_API_KEY=

# Optional: if you enable joblens.security.api-key.enabled=true (backend/application.yml),
# also set joblens.security.api-key.valid-keys to the key(s) you want the extension to send
# as the X-API-Key header. There's no single canonical env var for this since it's a set -
# either edit application.yml directly or override it via a JAVA_TOOL_OPTIONS/command-line
# -D flag when running the jar/Docker image, e.g.:
#   -Djoblens.security.api-key.valid-keys=<your-key>
